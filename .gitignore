# Local files
.DS_Store
.thumbsdb
.svn
init.sh
templates/*
languages/*

# Theme and Plugin handling
#
# Ignore the parent, but explicitly exclude (from ignore)
# any themes or plugins we wish to source control.
#
# example exclusion:
#
# !plugins/jetpack
# !mu-plugins/hello.php
# !themes/twentyseventeen
#
plugins/*
!plugins/book-viewer-block

*/node_modules/*



mu-plugins/*
!mu-plugins/mu-loader.php
!mu-plugins/tobacco-archive
# !mu-plugins/saggy-pants-archive

# Exclude the source HTML files from saggy-pants-archive
# mu-plugins/saggy-pants-archive/Saggy-Pants*
# mu-plugins/saggy-pants-archive/Saggy-Pants 09/

# Exclude import temp directory
import_temp/



themes/*
!themes/glynnquelch2025

TR



# Other wp-content exclusions
upgrade/*
uploads/*
